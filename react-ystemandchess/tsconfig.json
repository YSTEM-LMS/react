{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2020"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "src/types"
    ],
    "types": [
      "vite/client",
      "jest",
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "src/lib"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ]
}
