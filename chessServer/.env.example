NODE_ENV=development

# Port the socket/HTTP server listens on. Defaults to 3001 if unset.
PORT=3001

# Comma-separated list of origins allowed to connect (CORS + Socket.IO).
# Falls back to a hardcoded dev/prod allowlist in src/index.js if unset.
# Required in production (one of CORS_ORIGIN or ALLOWED_ORIGINS).
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
ALLOWED_ORIGINS=

# Base URL of middlewareNode, used to verify PvP game identity
# (GET /challenge/game/:gameId) and to report finished game results
# (POST /internal/gameResults). Required in production.
MIDDLEWARE_URL=http://localhost:8000

# Shared secret the chess server authenticates with when reporting a PvP
# result to the middleware (X-Service-Key header). Must match the same
# value configured on middlewareNode. Required in production. See the PvP
# results plan (v2), T5 — generate one random 32-byte value and store it as
# a secret on both services, not in source control.
CHESS_SERVICE_KEY=
